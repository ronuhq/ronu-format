{
  "$id": "https://raw.githubusercontent.com/ronuhq/ronu-format/main/schema/ronu-module.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "definitions": {
    "BackdropConfig": {
      "additionalProperties": true,
      "properties": {
        "image": {
          "type": [
            "string",
            "null"
          ]
        },
        "intensity": {
          "description": "`\"subtle\"` | `\"medium\"` (default) | `\"bold\"`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Choice": {
      "additionalProperties": true,
      "properties": {
        "actions": {
          "items": {
            "$ref": "#/definitions/VariableAction"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "connection": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Choices": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/definitions/Choice"
          },
          "type": "array"
        },
        {
          "description": "Legacy: a stringified `ConditionConfig` (see spec §8).",
          "type": "string"
        }
      ],
      "description": "`config.choices` is either a structured list (choice / multipleChoice) or a JSON-encoded string (legacy condition nodes). Untagged so both forms parse."
    },
    "CompletionRule": {
      "additionalProperties": true,
      "properties": {
        "certificate": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "certificateValidityMonths": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "mode": {
          "description": "`\"variable\"` (default) | `\"reachedNode\"` | `\"nodeScore\"`.",
          "type": [
            "string",
            "null"
          ]
        },
        "operator": {
          "type": [
            "string",
            "null"
          ]
        },
        "passNodeId": {
          "type": [
            "string",
            "null"
          ]
        },
        "scoreAggregate": {
          "type": [
            "string",
            "null"
          ]
        },
        "scoreNodeId": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": true,
        "variableId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Condition": {
      "additionalProperties": true,
      "properties": {
        "field": {
          "description": "A node id or a variable id — or the literal `\"operator\"`.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "operator": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": true
      },
      "type": "object"
    },
    "ConditionConfig": {
      "additionalProperties": true,
      "properties": {
        "criteriaSets": {
          "default": [],
          "items": {
            "$ref": "#/definitions/CriteriaSet"
          },
          "type": "array"
        },
        "defaultPathLabel": {
          "type": [
            "string",
            "null"
          ]
        },
        "defaultTargetNodeId": {
          "type": [
            "string",
            "null"
          ]
        },
        "useRealEvaluation": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "CriteriaSet": {
      "additionalProperties": true,
      "properties": {
        "conditions": {
          "default": [],
          "items": {
            "$ref": "#/definitions/Condition"
          },
          "type": "array"
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "pathLabel": {
          "type": [
            "string",
            "null"
          ]
        },
        "targetNodeId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "DragItem": {
      "additionalProperties": true,
      "description": "A thing to place. No `targetId` means it belongs nowhere: a distractor.",
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "image": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "targetId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "DragTarget": {
      "additionalProperties": true,
      "description": "A place something belongs.",
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "image": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "HotspotConversation": {
      "additionalProperties": true,
      "properties": {
        "criteria": {
          "description": "The grader's rubric (same shape as a conversation node's `rubric`).",
          "items": {
            "$ref": "#/definitions/RubricCriterion"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "firstMessage": {
          "type": [
            "string",
            "null"
          ]
        },
        "maxTurns": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "objective": {
          "type": [
            "string",
            "null"
          ]
        },
        "persona": {
          "type": [
            "string",
            "null"
          ]
        },
        "scoreVariableId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "MatchingLeftItem": {
      "additionalProperties": true,
      "properties": {
        "actions": {
          "items": {
            "$ref": "#/definitions/VariableAction"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "correctRightId": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "image": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "MatchingRightItem": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "image": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ModuleSettings": {
      "additionalProperties": true,
      "properties": {
        "backdrop": {
          "anyOf": [
            {
              "$ref": "#/definitions/BackdropConfig"
            },
            {
              "type": "null"
            }
          ],
          "description": "Default decorative image behind learner-facing nodes; a node overrides it with `config.backgroundImage` (the empty string means none)."
        },
        "completion": {
          "anyOf": [
            {
              "$ref": "#/definitions/CompletionRule"
            },
            {
              "type": "null"
            }
          ]
        },
        "timer": {
          "anyOf": [
            {
              "$ref": "#/definitions/TimerConfig"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "Node": {
      "additionalProperties": true,
      "description": "A node in the scenario graph. `type` stays a string so unknown node types surface as `node/unknown-type` (validation) instead of a parse error.",
      "properties": {
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "config": {
          "anyOf": [
            {
              "$ref": "#/definitions/NodeConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "connection": {
          "description": "Single forward connection for non-branching nodes.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "position": {
          "anyOf": [
            {
              "$ref": "#/definitions/Point"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "NodeConfig": {
      "additionalProperties": true,
      "description": "The per-node config bag. Only the fields the skeleton + validator need are typed; everything else (the growing node *catalogue*) rides in `extra`.",
      "properties": {
        "abortWhen": {
          "anyOf": [
            {
              "$ref": "#/definitions/SceneAbortRule"
            },
            {
              "type": "null"
            }
          ],
          "description": "Leave the scene early (to a debrief) when a variable crosses a line."
        },
        "choices": {
          "anyOf": [
            {
              "$ref": "#/definitions/Choices"
            },
            {
              "type": "null"
            }
          ]
        },
        "completion": {
          "description": "Scene completion mode: `\"free\"` | `\"allRequired\"`.",
          "type": [
            "string",
            "null"
          ]
        },
        "connection": {
          "type": [
            "string",
            "null"
          ]
        },
        "content": {
          "description": "`message` body (rich text / HTML).",
          "type": [
            "string",
            "null"
          ]
        },
        "criteria": {
          "anyOf": [
            {
              "$ref": "#/definitions/ConditionConfig"
            },
            {
              "type": "null"
            }
          ],
          "description": "Canonical condition criteria (spec §8). Exporters emit this; readers accept this OR the legacy stringified `choices`."
        },
        "dragItems": {
          "items": {
            "$ref": "#/definitions/DragItem"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "dragTargets": {
          "items": {
            "$ref": "#/definitions/DragTarget"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "environment": {
          "anyOf": [
            {
              "$ref": "#/definitions/SceneEnvironment"
            },
            {
              "type": "null"
            }
          ]
        },
        "firstMessage": {
          "type": [
            "string",
            "null"
          ]
        },
        "hotspots": {
          "items": {
            "$ref": "#/definitions/SceneHotspot"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "isStart": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "matchingLeftItems": {
          "items": {
            "$ref": "#/definitions/MatchingLeftItem"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "matchingRightItems": {
          "items": {
            "$ref": "#/definitions/MatchingRightItem"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "maxTurns": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "missActions": {
          "items": {
            "$ref": "#/definitions/VariableAction"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "objective": {
          "type": [
            "string",
            "null"
          ]
        },
        "persona": {
          "type": [
            "string",
            "null"
          ]
        },
        "procedureHaltOnCritical": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "procedureSteps": {
          "items": {
            "$ref": "#/definitions/ProcedureStep"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "question": {
          "description": "The prompt for any question-shaped type (also read on a nested scene interaction, where a question type with no text is flagged).",
          "type": [
            "string",
            "null"
          ]
        },
        "rankingItems": {
          "items": {
            "$ref": "#/definitions/RankingItem"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "ratingMax": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "ratingMin": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "ratingVariableId": {
          "type": [
            "string",
            "null"
          ]
        },
        "rubric": {
          "description": "Named things the AI grader judges separately. Called `rubric` here because `criteria` is the condition node's name on this same config.",
          "items": {
            "$ref": "#/definitions/RubricCriterion"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "scoreVariableId": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "description": "The sandboxed `run({ctx, ui, emit})` body. Never execute it outside a sandbox.",
          "type": [
            "string",
            "null"
          ]
        },
        "timer": {
          "anyOf": [
            {
              "$ref": "#/definitions/TimerConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "triggers": {
          "items": {
            "$ref": "#/definitions/NodeTrigger"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "NodeTrigger": {
      "additionalProperties": true,
      "properties": {
        "actions": {
          "default": [],
          "items": {
            "$ref": "#/definitions/VariableAction"
          },
          "type": "array"
        },
        "config": true,
        "type": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Point": {
      "properties": {
        "x": {
          "default": 0.0,
          "format": "double",
          "type": "number"
        },
        "y": {
          "default": 0.0,
          "format": "double",
          "type": "number"
        }
      },
      "type": "object"
    },
    "ProcedureStep": {
      "additionalProperties": true,
      "description": "One step of a `procedure`, in the order it must be performed.",
      "properties": {
        "critical": {
          "description": "A step that must never be skipped; skipping it fails the procedure.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "earlyActions": {
          "description": "Fired when this step is taken out of turn: the consequence.",
          "items": {
            "$ref": "#/definitions/VariableAction"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "ifEarly": {
          "description": "Shown when this step is taken out of turn.",
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "RankingItem": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/definitions/RankingItemRich"
        },
        true
      ],
      "description": "A ranking item is a plain string, or an object once an image is attached. Untagged so both forms parse; the last variant keeps the reader liberal."
    },
    "RankingItemRich": {
      "additionalProperties": true,
      "properties": {
        "image": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "RubricCriterion": {
      "additionalProperties": true,
      "description": "One thing the AI grader is asked to judge. A name and a weight, never an operator: deterministic pass/fail stays with the comparison rules.",
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "weight": {
          "description": "Relative importance; defaults to 1.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "SceneAbortRule": {
      "additionalProperties": true,
      "description": "Early-exit rule for a scene: when the variable satisfies the comparison the learner leaves for `targetNodeId` (a debrief) instead of finishing the room. The same variable/operator/value triple as a completion rule.",
      "properties": {
        "operator": {
          "description": "Defaults to `\"is_true\"`.",
          "type": [
            "string",
            "null"
          ]
        },
        "targetNodeId": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": true,
        "variableId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "SceneEnvironment": {
      "additionalProperties": true,
      "properties": {
        "kind": {
          "description": "`\"photo360\"` | `\"photo2d\"` | `\"splat\"` | `\"embed3d\"`.",
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "SceneHotspot": {
      "additionalProperties": true,
      "properties": {
        "conversation": {
          "anyOf": [
            {
              "$ref": "#/definitions/HotspotConversation"
            },
            {
              "type": "null"
            }
          ]
        },
        "hidden": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "interaction": {
          "anyOf": [
            {
              "$ref": "#/definitions/SceneHotspotInteraction"
            },
            {
              "type": "null"
            }
          ],
          "description": "Clicking opens an inline question or message, answered in the room."
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "position": {
          "description": "Anchor — shape varies by environment (yaw/pitch, x/y, or x/y/z)."
        },
        "required": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "reveal": true,
        "targetNodeId": {
          "type": [
            "string",
            "null"
          ]
        },
        "variableActions": {
          "items": {
            "$ref": "#/definitions/VariableAction"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "SceneHotspotInteraction": {
      "additionalProperties": true,
      "description": "A node rendered inline inside a scene when its hotspot is clicked. The learner is assessed at the point of action and stays in the room. `type` is one of the nestable types (message, multipleChoice, textInput, matching, ranking, rating, procedure, dragToTarget); routing types never nest, so the canvas stays the single source of truth for flow. `config` is an ordinary node config, so the same profiles apply.",
      "properties": {
        "config": {
          "anyOf": [
            {
              "$ref": "#/definitions/NodeConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "TimerConfig": {
      "additionalProperties": true,
      "properties": {
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "description": "`\"countdown\"` | `\"countup\"`.",
          "type": [
            "string",
            "null"
          ]
        },
        "onExpire": {
          "anyOf": [
            {
              "$ref": "#/definitions/TimerExpire"
            },
            {
              "type": "null"
            }
          ]
        },
        "recordVariableId": {
          "type": [
            "string",
            "null"
          ]
        },
        "seconds": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "sound": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "visible": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "warnAtSeconds": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "TimerExpire": {
      "additionalProperties": true,
      "properties": {
        "actions": {
          "items": {
            "$ref": "#/definitions/VariableAction"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "behavior": {
          "description": "`\"none\"` | `\"advance\"` | `\"route\"` | `\"end\"`.",
          "type": [
            "string",
            "null"
          ]
        },
        "targetNodeId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Variable": {
      "additionalProperties": true,
      "description": "`type` and `initialValue` stay loose (string / arbitrary JSON) so mismatches surface as validation issues, not parse failures.",
      "properties": {
        "carriedInFrom": {
          "description": "The module a learner-scope variable was carried in from.",
          "type": [
            "string",
            "null"
          ]
        },
        "computed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "formula": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "initialValue": true,
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "description": "`\"module\"` (default) | `\"learner\"`.",
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "type": [
            "string",
            "null"
          ]
        },
        "visible": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "VariableAction": {
      "additionalProperties": true,
      "properties": {
        "operator": {
