  "spec": [
    "7.2"
  ],
  "gaps": [
    "G41"
  ],
  "level": 1,
  "requires": [
    "scene",
    "multipleChoice",
    "message"
  ],
  "play": [
    {
      "at": "start"
    },
    {
      "activateHotspot": "q"
    },
    {
      "dismissBeat": true
    },
    {
      "continue": true
    },
    {
      "activateHotspot": "q"
    },
    {
      "answerMultiple": [
        "right"
      ]
    },
    {
      "dismissBeat": true
    },
    {
      "continue": true
    },
    {
      "dismissBeat": true
    },
    {
      "continue": true
    }
  ],
  "expect": {
